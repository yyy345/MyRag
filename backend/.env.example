# Copy explicitly into your process environment; this service never reads server/.env.
GO_HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://postgres:migration-test-only@127.0.0.1:55432/migration_test
REDIS_URL=redis://127.0.0.1:56380/0
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:55673/
JWT_SECRET=replace-with-at-least-32-random-characters
AI_BASE_URL=http://127.0.0.1:8000
AI_PARSE_TIMEOUT=60s
AI_SERVICE_TOKEN=replace-with-a-shared-internal-service-token
# Opt in only after reviewing provider costs. API never starts the scheduler.
AUTO_EXTRACT_ENABLED=false
# Optional during migration. Set all four values to enable image storage.
# OSS_REGION accepts cn-hangzhou or the legacy oss-cn-hangzhou value.
# OSS_REGION=cn-hangzhou
# OSS_BUCKET=replace-with-bucket-name
# OSS_ACCESS_KEY_ID=replace-with-access-key-id
# OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
# OSS_SECURITY_TOKEN=optional-sts-token
