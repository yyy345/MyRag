# Export into the Python process environment; do not copy production .env files.
# Must match Go AI_SERVICE_TOKEN: at least 32 printable, non-space ASCII characters.
AI_SERVICE_TOKEN=replace-with-a-shared-internal-service-token
# Real model calls require explicit opt-in and are never part of agent tests.
AI_PROVIDER_ENABLED=false
AI_CHAT_PROVIDER=deepseek
# hybrid requires a separate embedding key; fulltext queries existing indexed chunks locally.
AI_RETRIEVAL_MODE=hybrid
AI_VISION_PROVIDER=deepseek
# Fill privately; DeepSeek keys are never used for embeddings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Requested V4 Flash alias currently routes to V4.1 Flash; deepseek-flash is also accepted.
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
# Existing 1024-dimension Embedding remains Bailian; required for RAG/Worker.
# Set AI_CHAT_PROVIDER=bailian / AI_VISION_PROVIDER=bailian to use legacy models.
# BAILIAN_API_KEY=replace-with-provider-key
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BAILIAN_VISION_MODEL=qwen-vl-plus
# BAILIAN_LLM_MODEL=qwen-plus
# BAILIAN_EMBEDDING_MODEL=text-embedding-v3
# API retrieval and Worker: set explicit DSNs; HTTP API never starts a Worker.
# DATABASE_URL=postgresql://postgres:migration-test-only@127.0.0.1:55432/migration_test
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:55673/
