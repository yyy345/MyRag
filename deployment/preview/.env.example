# Only for the existing local ai-library-deployment-validation preview at 58088.
# These fixed database/internal credentials match scripts/test-deployment.ps1.
# Not a production template. Keep existing credentials if you changed that stack.
POSTGRES_USER=library
POSTGRES_PASSWORD=local-compose-test-only
POSTGRES_DB=ai_library
DATABASE_URL=postgresql://library:local-compose-test-only@postgres:5432/ai_library
RABBITMQ_USER=library
RABBITMQ_PASSWORD=local-compose-test-only
RABBITMQ_URL=amqp://library:local-compose-test-only@rabbitmq:5672/
JWT_SECRET=local-compose-test-secret-at-least-32-characters
AI_SERVICE_TOKEN=local-compose-service-token-at-least-32-characters
WEB_PORT=58088
AI_PROVIDER_ENABLED=false
AI_CHAT_PROVIDER=deepseek
AI_RETRIEVAL_MODE=fulltext
AI_VISION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
# Existing embeddings still require a separate Bailian key.
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
AUTO_EXTRACT_ENABLED=false
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
