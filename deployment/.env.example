# Copy to deployment/.env and replace placeholders. Never copy server/.env.
POSTGRES_USER=library
POSTGRES_PASSWORD=replace-with-random-url-safe-password
POSTGRES_DB=ai_library
DATABASE_URL=postgresql://library:replace-with-random-url-safe-password@postgres:5432/ai_library
RABBITMQ_USER=library
RABBITMQ_PASSWORD=replace-with-random-url-safe-password
RABBITMQ_URL=amqp://library:replace-with-random-url-safe-password@rabbitmq:5672/
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_SERVICE_TOKEN=replace-with-a-random-shared-token-at-least-32-characters
WEB_PORT=8088
# Disabled until user explicitly enables paid integrations.
AI_PROVIDER_ENABLED=false
AI_CHAT_PROVIDER=deepseek
AI_RETRIEVAL_MODE=hybrid
AI_VISION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
AUTO_EXTRACT_ENABLED=false
# Required separately for the existing 1024-dimension vectors and indexing Worker.
BAILIAN_API_KEY=
BAILIAN_EMBEDDING_MODEL=text-embedding-v3
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
