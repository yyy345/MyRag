{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IndexResultV1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "entry_id", "entry_version", "trace_id", "status", "chunk_count", "error_code"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "format": "uuid" },
    "entry_id": { "type": "string", "format": "uuid" },
    "entry_version": { "type": "integer", "minimum": 1 },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "status": { "enum": ["COMPLETED", "FAILED", "STALE"] },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "error_code": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "FAILED" } } }, "then": { "properties": { "error_code": { "type": "string", "minLength": 1 }, "chunk_count": { "const": 0 } } }, "else": { "properties": { "error_code": { "type": "null" } } } }
  ]
}
