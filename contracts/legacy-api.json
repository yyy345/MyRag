{
  "version": 1,
  "source": "Express source baseline, 2026-09-23",
  "envelope": { "code": 0, "data": {}, "message": "ok" },
  "pagination": { "total": 0, "records": [], "current": 1, "size": 10 },
  "routes": [
    { "module": "auth", "method": "GET", "path": "/captcha", "auth": false, "response": "{id,svg}; legacy content-type is SVG although body is JSON" },
    { "module": "auth", "method": "POST", "path": "/register", "auth": false, "body": ["username", "email", "password", "captchaId", "captchaCode"], "response": "{token,user}" },
    { "module": "auth", "method": "POST", "path": "/login", "auth": false, "body": ["username", "password", "captchaId", "captchaCode"], "response": "{token,user}; username also accepts email" },
    { "module": "auth", "method": "GET", "path": "/me", "auth": true, "response": "User" },
    { "module": "knowledge", "method": "POST", "path": "/", "auth": true, "body": ["name", "description?", "system_prompt?"], "response": "KnowledgeBase" },
    { "module": "knowledge", "method": "GET", "path": "/", "auth": true, "query": ["page=1", "size=10"], "response": "PaginatedData<KnowledgeBase>" },
    { "module": "knowledge", "method": "GET", "path": "/:id", "auth": true, "response": "KnowledgeBase" },
    { "module": "knowledge", "method": "PUT", "path": "/:id", "auth": true, "body": ["name?", "description?", "system_prompt?"], "response": "KnowledgeBase" },
    { "module": "knowledge", "method": "DELETE", "path": "/:id", "auth": true, "response": "null" },
    { "module": "knowledge", "method": "POST", "path": "/:id/entries", "auth": true, "body": ["title", "content"], "response": "KnowledgeEntry" },
    { "module": "knowledge", "method": "GET", "path": "/:id/entries", "auth": true, "query": ["page=1", "size=10", "search?", "status?"], "response": "PaginatedData<KnowledgeEntry>" },
    { "module": "knowledge", "method": "GET", "path": "/:id/entries/:eid", "auth": true, "response": "KnowledgeEntry" },
    { "module": "knowledge", "method": "PUT", "path": "/:id/entries/:eid", "auth": true, "body": ["title?", "content?"], "response": "KnowledgeEntry" },
    { "module": "knowledge", "method": "DELETE", "path": "/:id/entries/:eid", "auth": true, "response": "null; batch delete is multiple requests from the client" },
    { "module": "knowledge", "method": "PATCH", "path": "/:id/entries/:eid/status", "auth": true, "body": ["status"], "response": "KnowledgeEntry" },
    { "module": "knowledge", "method": "POST", "path": "/:id/entries/upload", "auth": true, "multipart": "file, max 20 MiB, PDF/DOCX/MD/TXT/CSV/XLSX", "response": "{entry_id,processing_status}; duplicate message: 文件已存在" },
    { "module": "knowledge", "method": "POST", "path": "/:id/entries/upload-images", "auth": true, "multipart": "images[], max 10 PNG/JPEG files, each max 5 MiB", "response": "{entries:[{entry_id,title}]} (inspect entry status for individual failure)" },
    { "module": "chat", "method": "POST", "path": "/:id/chat/sessions", "auth": true, "response": "ChatSession" },
    { "module": "chat", "method": "GET", "path": "/:id/chat/sessions", "auth": true, "response": "ChatSession[]" },
    { "module": "chat", "method": "GET", "path": "/:id/chat/sessions/:sid", "auth": true, "response": "ChatMessage[]" },
    { "module": "chat", "method": "DELETE", "path": "/:id/chat/sessions/:sid", "auth": true, "response": "null" },
    { "module": "chat", "method": "POST", "path": "/:id/chat/sessions/:sid/messages", "auth": true, "body": ["content"], "response": "SSE; no JSON envelope" },
    { "module": "chat", "method": "POST", "path": "/:id/chat/extract", "auth": true, "body": ["sessionId?"], "response": "{entries:[{id,title}],count?}; count omitted when no messages" },
    { "module": "analytics", "method": "GET", "path": "/overview", "auth": true, "response": "{hotEntries,kbActivity,summary:{kbCount,entryCount,sessionCount}}" },
    { "module": "analytics", "method": "GET", "path": "/kb/:id", "auth": true, "response": "{kbName,hotEntries}" },
    { "module": "debug", "method": "GET", "path": "/clear-cache", "auth": false, "response": "DEVELOPMENT ONLY; destructive; never invoke in baseline tests" }
  ],
  "mounts": { "auth": "/api/auth", "knowledge": "/api/knowledge-bases", "chat": "/api/knowledge-bases", "analytics": "/api/analytics", "debug": "/api/debug" },
  "errors": { "UNAUTHORIZED": 1001, "INVALID_CREDENTIALS": 1002, "USERNAME_EXISTS": 1003, "KB_NOT_FOUND": 2001, "ENTRY_NOT_FOUND": 2002, "DOCUMENT_PARSE_FAILED": 2003, "SESSION_NOT_FOUND": 3001, "INTERNAL_ERROR": 5000 },
  "samples": {
    "unauthorized": { "status": 401, "body": { "code": 1001, "message": "未登录，请先登录", "data": null } },
    "invalidToken": { "status": 401, "body": { "code": 1001, "message": "登录已过期，请重新登录", "data": null } },
    "chunk": { "type": "chunk", "content": "中文回答", "is_end": false },
    "done": { "type": "done", "is_end": true, "references": [{ "id": "entry-id", "title": "资料", "content": "引用内容" }], "usage": { "prompt_tokens": 20, "completion_tokens": 10 } },
    "streamError": { "type": "done", "is_end": true, "content": "生成回答时出错: test error" }
  },
  "cache": [
    { "key": "captcha:{id}", "ttl": 300 },
    { "key": "kb:{userId}:{page}:{size}", "ttl": 300 },
    { "key": "kb:detail:{kbId}", "ttl": 300 },
    { "key": "entry:{kbId}:{page}:{size}", "ttl": 120 },
    { "key": "entry:detail:{entryId}", "ttl": 120 },
    { "key": "chat:sessions:{kbId}", "ttl": 120 },
    { "key": "chat:messages:{sessionId}", "ttl": 120 },
    { "key": "analytics:overview:{userId}", "ttl": 300 },
    { "key": "analytics:kb:{kbId}", "ttl": 300 }
  ]
}
